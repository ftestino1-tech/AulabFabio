@using Blog.Web.Models.Domain
@model Blog.Web.Models.Domain.BlogPost


<div class="bg-secondary bg-opacity-10 py-2">
    <div class="container">
        <h1>Dettaglio di @Model.Heading</h1>
    </div>
</div>


<div class="container py-5">
    <div class="card shadow-sm">
        @if (!string.IsNullOrEmpty(Model.FeaturedImageUrl))
        {
            <img src="@Model.FeaturedImageUrl"
                class="card-img-top"
                alt="@Model.Heading">
        }

        <div class="card-body">
            <h3 class="card-title">@Model.Heading</h3>

            <p class="text-muted">
                Published on @Model.PublishedDate.ToShortDateString()
            </p>

            <div class="mb-3">
                <div class="d-flex flex-wrap gap-2">
                     @foreach (var Tagtag in Model.Tags)
                    {
                        <span class="badge bg-secondary">
                            @Tagtag.Name
                        </span>
                    }
                </div>
            </div>

            <p class="card-text">
                @Html.Raw(Model.Content)
            </p>

            <div class="mt-4">
                <a class="btn btn-secondary"
                    asp-controller="AdminBlogPosts"
                    asp-action="List">
                        Back to List        
                </a>
            </div>
        </div>
    </div>
</div>