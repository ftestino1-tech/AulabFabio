@model Blog.Web.Models.ViewModels.RegisterViewModel

<div class="container mx-auto">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-6">
            
            <h1 class="mt-3 mb-3 h3">Register</h1>

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <form method="post">
                <div class="mb-3">
                    <label class="form-laber">Username</label>
                    <input type="text" id="username" class="form-control" asp-for="UserName" />
                </div>

                <div class="mb-3">
                    <label class="form-laber">Email</label>
                    <input type="email" id="email" class="form-control" asp-for="Email" />
                </div>

                <div class="mb-3">
                    <label class="form-laber">Password</label>
                    <input type="password" id="password" class="form-control" asp-for="Password" />
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-dark">Register</button>
                </div>
            </form>

        </div>
    </div>
</div>