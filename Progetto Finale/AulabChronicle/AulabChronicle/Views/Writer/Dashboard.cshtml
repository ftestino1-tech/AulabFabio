@using AulabChronicle.Models.Domain
@model IEnumerable<AulabChronicle.Models.ViewModels.ArticleDto>

@{
    ViewData["Title"] = "Dashboard Writer";
}

<div class="row justify-content-center py-5">
    <div class="col-12 text-center mb-5">
        <h1 class="display-4 fw-bold">Dashboard Writer</h1>
        <div class="mx-auto" style="width: 80px; height: 5px; background: var(--primary-gradient); border-radius: 10px;"></div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert" style=border-radius: 12px;">
            <i class="fa-solid fa-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                <h3 class="fw-bold mb-0">I Miei Articoli</h3>

                <a asp-controller="Article" asp-action="Create" class="btn btn-gradient btn-sm px-3">
                    <i class="fa-solid fa-plus me-1"></i> Nuovo Articolo 
                </a>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Id</th>
                                <th>Titolo</th>
                                <th>Stato</th>
                                <th>Categoria</th>
                                <th>Data Creazione</th>
                                <th class="text-end pe-4">Azioni</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var article in Model)
                                {
                                    <tr>
                                        <td class="ps-4">@article.Id</td>

                                        <td>
                                            <div class="fw-semibold">@article.Title</div>
                                            <div class="small text-muted text-truncate" style="max-width: 200px;">
                                                @article.Subtitle
                                            </div>
                                        </td>

                                        <td>
                                            @if (article.IsAccepted == true)
                                            {
                                                <span class="badge bg-success-subtle text-success px-2 py-1">Pubblicato</span>
                                            }
                                            else if (article.IsAccepted == false)
                                            {
                                                <span class="badge bg-danger-subtle text-danger px-2 py-1">Rifiutato</span>
                                            }
                                            else 
                                            {
                                                <span class="badge bg-warning-subtle text-warning px-2 py-1">In Revisione</span>
                                            }
                                        </td>

                                        <td>
                                            <span class="badge bg-light text-primary border">
                                                @(article.Category?.Name ?? "nessuna categoria")
                                            </span>
                                        </td>

                                        <td>
                                            <div class="small text-muted">
                                                @article.CreatedAt.ToString("dd/MM/yyyy")
                                            </div>
                                        </td>

                                        <td class="text-end pe-4">
                                            <div class="d-flex justify-content-end gap-2">
                                                <a asp-controller="Article"
                                                    asp-action="Details"
                                                    asp-route-id="@article.Id"
                                                    class="btn btn-sm btn-outline-primary rounded-circle"
                                                    style="width: 32px; height: 32px; padding: 0;"
                                                    title="Vedi">
                                                      <i class="fa-solid fa-eye small"></i>
                                                </a>

                                                <a asp-controller="Article"
                                                    asp-action="Edit"
                                                    asp-route-id="@article.Id"
                                                    class="btn btn-sm btn-outline-warning rounded-circle"
                                                    style="width: 32px; height: 32px; padding: 0;"
                                                    title="Modifica">
                                                      <i class="fa-solid fa-pencil small"></i>    
                                                </a>

                                                <a asp-controller="Article"
                                                    asp-action="Delete"
                                                    asp-route-id="@article.Id"
                                                    class="btn btn-sm btn-outline-danger rounded-circle"
                                                    style="width: 32px; height: 32px; padding: 0;"
                                                    title="Elimina"
                                                    onclick="return confirm('Sei sicuro di voler eliminare questo articolo?')">
                                                      <i class="fa-solid fa-trash small"></i>    
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        Non hai ancora scritto alcun articolo. 
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


