@model AulabChronicle.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Registrazione";
}

<div class="row justify-content-center py-5">
    <div class="col-md-5">
        <div class="card border-0 shadow-lg rounded-4 everflow-hidden">
            <div class="p-4 text-center" style="background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);">
                <h2 class="text-white fw-bolf mb-0">Unisciti a noi</h2>
                <p class="text-white-50 small">Crea il tuo account per iniziare a scrivere</p>
            </div>

            <div class="card-body p-5">
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label fw-semibold">Nome</label>
                            <input asp-for="FirstName" class="form-control border-2" style="border-radius: 10px;" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label fw-semibold">Cognome</label>
                            <input asp-for="LastName" class="form-control border-2" style="border-radius: 10px;" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Email" class="form-label fw-semibold">Email</label>
                            <input asp-for="Email" class="form-control border-2" style="border-radius: 10px;" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Password" class="form-label fw-semibold">Password</label>
                            <input asp-for="Password" type="password" class="form-control border-2" style="border-radius: 10px;" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-gradient w-100 py-2" style="border-radius: 10px;">
                                Registrati
                            </button>
                        </div>
                    </div>
                </form>
                <div class="text-center mt-4">
                    <p class="text-muted small">
                        Hai già un account?
                        <a asp-action="Login" class="text-primary fw-bold text-decoration-none">Accedi qui</a>
                    </p>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
