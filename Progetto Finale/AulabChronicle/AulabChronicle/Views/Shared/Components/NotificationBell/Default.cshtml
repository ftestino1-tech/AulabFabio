@model int

@if (Model > 0) 
{
    <div class="mt-1 d-inline-block ms-1">
        <i class="fas fa-bell text-warning"></i>
        <span class="badge rounded-pill bg-danger text-white px-1" style="font-size: 0.65rem; vertical-align: top; margin-left: -8px;">
           @Model 
        </span>
    </div>
}