@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> signInManager


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AulabChronicle</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
            --glass-bg:rgba(255, 255, 255, 0.7);
            --glass-border:rgba(255, 255, 255, 0.3);
        }

        body {
            font-family: 'Outfit', sans-serif;
            background: #f8fafc;
            color: #1e293b;
        }

        .navbar {
            background: var(--glass-bg);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--glass-border);
            padding: 1rem 0;
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 1.5rem;
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-link {
            font-weight: 600;
            color: #475569 !important;
            transition: all 0.3s ease;
        }

        .nav-link:hover{
            color: #6366f1 !important;
            transform: translateY(-2px);
        }

        .btn-gradient {
            background: var(--primary-gradient);
            color: white;
            border: none;
            border-radius: 8px;
            padding: 0.6rem 1.5rem;
            font-weight: 600;
            transition: all 0.3s ease;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }

        .btn-gradien:hover {
            transform: sclae(1.05);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            color: white;
        }

        footer {
            background: #0f172a;
            color: #94a3b8;
            padding: 4rem 0 2rem;
            margin-top: 5rem;
        }

        footer h5 {
            color: white;
            font-weight: 700;
            margin-bottom: 1.5rem;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg sticky-top">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Aulab Chronicle</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Article" asp-action="Index">Tutti gli articoli</a>
                        </li>
                        @if (signInManager.IsSignedIn(User))
                        {
                            @if (User.IsInRole("Writer"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-primary fw-bold" asp-controller="Article" asp-action="Create">
                                        <i class="fa-solid fa-plus-circle me-1"></i> Crea Articolo
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Writer" asp-action="Dashboard">
                                        Writer Dshboard
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">
                                        Admin Dashboard @await Component.InvokeAsync("NotificationBell", new { role = "Admin" })
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Revisor"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Revisor" asp-action="Dashboard">
                                        Revisor Dashboard @await Component.InvokeAsync("NotificationBell", new { role = "Revisor" })
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <form class="d-flex me-lg-4 mb-2 mb-lg-0" asp-controller="Article" asp-action="Search" method="get">
                        <div class="input-group input-group-sm" style="max-width: 250px;">
                            <input class="form-control border-0 light" type="search" name="keyword" placeholder="Cerca articoli..." aria-label="Search" style="border-radius: 20px 0 20px; padding-left: 15px;">
                            <button class="btn btn-light border-0" type="submit" style="border-radius: 0 20px 20px 0;">
                                <i class="fa-solid fa-magnifying-glass text-muted"></i>
                            </button>
                        </div>
                    </form>

                    <div class="d-flex align-items-center">
                        @if (signInManager.IsSignedIn(User))
                        {
                            <div class="dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown">
                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px;">
                                        @User.Identity?.Name[0]
                                    </div>
                                    <div class="text-start">
                                        <div class="fw-bold lh-1" style="font-size: 0.9rem;">@User.Identity?.Name</div>
                                        <div class="text-muted small lh-1" style="font-size: 0.7rem;">
                                            @if (User.IsInRole("Admin")) { <text>Admin</text> }
                                            else if (User.IsInRole("Revisor")) { <text>Revisor</text> }
                                            else if (User.IsInRole("Writer")) { <text>Writer</text> }
                                            else { <text>User</text> }
                                        </div>
                                    </div>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                    <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="Logout"><i class="fa-solid fa-sign-out-alt me-2 text-danger"></i>Logout</a></li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="nav-link me-3" asp-controller="Account" asp-action="Login">Accedi</a>
                            <a class="btn btn-gradient" asp-controller="Account" asp-action="Register">Registrati</a>
                        }
                    </div>
                </div>
            </nav>
        </header>

    <div class="container mt-4">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert" style="border-radius: 12px; background: #fef2f2; color: #991b1b;">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer>
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5>Aulab Chronicle</h5>
                    <p>La tua fonte quotidiana di notizie, tecnologia e cultura.</p>
                </div>
                <div class="col-md-2 offset-md-2">
                    <h5>Link Rapidi</h5>
                    <ul class="list-unstyled">
                        <li><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a></li>
                        <li><a asp-controller="Article" asp-action="Index" class="text-decoration-none text-muted">Tutti gli articoli</a></li>
                    </ul>
                </div>
                <div class="col-md-4 text-md-end">
                    <h5>Lavora con noi</h5>
                    <p>Sei un aspirante scrittore? Unisciti al nostro team.</p>
                    <a asp-controller="Operations" asp-action="CareerRequest" class="btn btn-outline-light rounded-pill px-4">Candidati</a>
                </div>
            </div>
            <hr class="mt-5 border-secondary">
            <div class="text-center py-3">
                <p class="mb-0 small">&copy; 2026 - Aulab Chronicle - All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>