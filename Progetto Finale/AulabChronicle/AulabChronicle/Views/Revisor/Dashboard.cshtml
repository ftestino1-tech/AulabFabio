@model IEnumerable<AulabChronicle.Models.ViewModels.ArticleDto>

    @{
        ViewData["Title"] = "Revisor Dashboard";
    }

    <div class="container py-5">
        <h1 class="fw-bold mb-4">Revisor Dashboard</h1>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <h3 class="fw-bold mb-4">Articoli da revisionare</h3>

                @if (Model != null && Model.Any())
                {
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Titolo</th>
                                <th>Autore</th>
                                <th>Categoria</th>
                                <th>Data creazione</th>
                                <th>Azioni</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var article in Model)
                            {
                                <tr>
                                    <td>@article.Title</td>
                                    <td>@(article.User?.UserName ?? "Utente rimosso")</td>
                                    <td>@(article.Category?.Name ?? "nessuna categoria")</td>
                                    <td>@article.CreatedAt.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <a asp-controller="Revisor"
                                           asp-action="Detail"
                                           asp-route-id="@article.Id"
                                           class="btn btn-outline-primary btn-sm rounded-pill">
                                            Leggi   
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else 
                {
                    <p class="text-muted mb-0">Non ci sono articoli da revisionare.</p>
                }
            </div>
        </div>
    </div>