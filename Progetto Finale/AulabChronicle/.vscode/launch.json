{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ASP.NET Core (Debug)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/AulabChronicle/bin/Debug/net9.0/AulabChronicle.dll",
            "args": [],
            "cwd": "${workspaceFolder}/AulabChronicle",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "https://localhost:7019"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Now listening on: (https?://\\S+)"
            }
        }
    ]
}